---
import { Image } from "astro:assets";
import LuthraLogo from "../assets/luthra-logo.jpg";
import HeerLogo from "../assets/heer-logo.png";
---

<section
  id="about"
  class="fade-up bg-bg py-24 px-6 lg:px-12 border-t border-border"
>
  <div class="max-w-6xl mx-auto">
    <!-- Heading -->
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4">About GroverHQ</h2>
      <p class="text-muted text-lg max-w-2xl mx-auto">
        A modern, founder‐led tech agency focused on building fast, scalable,
        and beautifully crafted digital products.
      </p>
    </div>

    <!-- Content -->
    <div class="max-w-4xl mx-auto text-center text-ink leading-relaxed">
      <p class="mb-6">
        GroverHQ was created with a simple belief — businesses deserve digital
        experiences that are fast, reliable, and designed with intention. We
        combine modern engineering with clean design to help brands grow with
        confidence.
      </p>

      <p class="mb-6">
        Led by developers from top MNCs, we bring deep technical expertise,
        founder‐level attention, and a commitment to delivering work that feels
        premium, purposeful, and future‐ready.
      </p>
    </div>

    <!-- Our Clients -->
    <div class="mt-20">
      <h3 class="text-center text-2xl font-semibold mb-10">Our Clients</h3>

      <div class="flex flex-wrap justify-center items-center gap-6">
        <a
          href="https://luthrainteriors.com"
          target="_blank"
          rel="noopener noreferrer"
          class="w-56 h-32 flex items-center justify-center p-4 hover:opacity-80 transition"
        >
          <Image
            src={LuthraLogo}
            alt="Luthra Interiors Logo"
            class="max-w-full max-h-full w-auto h-auto object-contain rounded-2xl"
          />
        </a>
        <a
          href="https://heermedcentre.in"
          target="_blank"
          rel="noopener noreferrer"
          class="w-56 h-32 flex items-center justify-center p-4 hover:opacity-80 transition"
        >
          <Image
            src={HeerLogo}
            alt="Heer Heart & Lung Clinic Logo"
            class="max-w-full max-h-full w-auto h-auto object-contain rounded-2xl bg-[#ebe2c6]"
          />
        </a>
      </div>
    </div>
  </div>
</section>
