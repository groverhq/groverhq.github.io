---
import { PACKAGES, inr } from "../data/pricing";

interface Props {
    class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class={className}>
<a
    href="/packages/"
    class="block group p-6 lg:p-8 bg-bg border border-border rounded-xl transition-all duration-300 hover:border-accent hover:shadow-xl"
>
    <div
        class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"
    >
        <div>
            <p class="text-accent text-sm font-semibold mb-1">
                Start with a package
            </p>
            <p class="text-ink font-semibold text-lg">
                Get found on Google, then stay found.
            </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-6 sm:gap-10">
            <div>
                <p class="text-muted text-sm">
                    Website + Google Business Profile
                </p>
                <p class="text-ink font-bold text-xl">
                    {inr(PACKAGES.setup.price)}
                    <span
                        class="text-muted text-sm font-normal line-through"
                        >{inr(PACKAGES.setup.mrp)}</span
                    >
                    <span class="text-muted text-sm font-normal"
                        >one-time</span
                    >
                </p>
            </div>
            <div>
                <p class="text-muted text-sm">
                    SEO + Website Maintenance
                </p>
                <p class="text-ink font-bold text-xl">
                    {inr(PACKAGES.maintenance.price)}
                    <span
                        class="text-muted text-sm font-normal line-through"
                        >{inr(PACKAGES.maintenance.mrp)}</span
                    >
                    <span class="text-muted text-sm font-normal"
                        >/ month</span
                    >
                </p>
            </div>
        </div>
        <span
            class="text-accent font-medium group-hover:translate-x-1 transition-transform"
            >View packages →</span
        >
    </div>
</a>
</div>
