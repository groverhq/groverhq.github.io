---
import { Image } from "astro:assets";
import Logo from "../assets/logo-light.png";
import { NAV_LINKS } from "../config";

type NavLink = {
  name: string;
  href: string;
};
---

<nav
  class="sticky top-0 z-50 w-full flex items-center justify-between px-6 lg:px-8 py-3 border-b border-border bg-bg/95 backdrop-blur-sm"
>
  <!-- Logo -->
  <a href="/" class="block transition hover:scale-[1.02]">
    <Image
      src={Logo}
      alt="GroverHQ Logo"
      width={500}
      height={500}
      format="webp"
      loading="eager"
      decoding="async"
      class="h-9 lg:h-10 w-auto object-contain"
    />
  </a>

  <!-- Desktop Links + CTA -->
  <div class="hidden md:flex items-center gap-8">
    {
      NAV_LINKS.map((link: NavLink) => (
        <a href={link.href} class="text-muted hover:text-accent transition">
          {link.name}
        </a>
      ))
    }
    <a
      href="/#contact"
      class="px-5 py-2 bg-accent text-accent-ink rounded-full font-medium hover:opacity-90 transition"
    >
      Start a Project</a
    >
  </div>

  <!-- Mobile Hamburger -->
  <button
    id="mobileMenuBtn"
    class="md:hidden text-ink focus:outline-none"
    aria-label="Open menu"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-6 h-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
</nav>

<!-- Mobile Menu Modal Overlay -->
<div
  id="mobileMenuOverlay"
  class="hidden fixed inset-0 z-60 bg-bg/98 backdrop-blur-sm flex-col items-center justify-center gap-8 md:hidden"
>
  <button
    id="mobileMenuCloseBtn"
    class="absolute top-5 right-6 text-ink"
    aria-label="Close menu"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-7 h-7"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  {
    NAV_LINKS.map((link: NavLink) => (
      <a
        href={link.href}
        class="text-2xl text-ink hover:text-accent transition"
      >
        {link.name}
      </a>
    ))
  }

  <a
    href="/#contact"
    class="mt-4 px-8 py-3 bg-accent text-accent-ink rounded-full font-medium hover:opacity-90 transition"
  >
    Start a Project</a
  >
</div>

<script is:inline>
  const btn = document.getElementById("mobileMenuBtn");
  const closeBtn = document.getElementById("mobileMenuCloseBtn");
  const overlay = document.getElementById("mobileMenuOverlay");

  function openMenu() {
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    document.body.style.overflow = "";
  }

  btn.addEventListener("click", openMenu);
  closeBtn.addEventListener("click", closeMenu);

  overlay.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
