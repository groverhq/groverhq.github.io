<section
    id="contact"
    class="fade-up bg-surface text-ink py-24 px-6 lg:px-12 border-t border-border"
>
    <div class="max-w-6xl mx-auto">
        <!-- Heading -->
        <div class="text-center mb-16">
            <h2 class="text-3xl lg:text-5xl font-bold mb-4">
                Let's Build Something Great
            </h2>
            <p class="text-muted text-lg max-w-2xl mx-auto">
                Have a project in mind? Tell us a bit about it and we’ll get
                back to you soon.
            </p>
        </div>

        <!-- Form + Contact Info -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            <!-- Contact Form -->
            <form id="contactForm" class="space-y-6" onsubmit="return false;" novalidate>
                <!-- Name -->
                <div>
                    <label for="name" class="block text-ink mb-2">Name</label>
                    <input
                        id="name"
                        type="text"
                        maxlength="80"
                        class="input-field"
                        placeholder="Your name"
                        autocomplete="name"
                    />
                    <p id="error-name" class="error-text hidden">
                        Please enter your name
                    </p>
                </div>

                <!-- Email -->
                <div>
                    <label for="email" class="block text-ink mb-2">Email</label>
                    <input
                        id="email"
                        type="email"
                        inputmode="email"
                        maxlength="254"
                        class="input-field"
                        placeholder="you@example.com"
                        autocomplete="email"
                    />
                    <p id="error-email" class="error-text hidden">
                        Please enter a valid email address
                    </p>
                </div>

                <!-- Phone -->
                <div>
                    <label for="phone" class="block text-ink mb-2"
                        >Phone Number</label
                    >
                    <input
                        id="phone"
                        type="tel"
                        maxlength="25"
                        class="input-field"
                        placeholder="9878236480 or +1 605 555 0123"
                        autocomplete="tel"
                    />
                    <p id="error-phone" class="error-text hidden">
                        Enter a 10-digit Indian mobile number, or an
                        international number starting with + and country code
                    </p>
                </div>

                <!-- Message -->
                <div>
                    <label for="message" class="block text-ink mb-2"
                        >Message</label
                    >
                    <textarea
                        id="message"
                        rows="5"
                        maxlength="1500"
                        class="input-field"
                        placeholder="Tell us about your project..."></textarea>
                    <p id="message-count" class="text-muted text-xs mt-1 text-right">
                        0 / 1500
                    </p>
                    <p id="error-message" class="error-text hidden">
                        Please enter a message (5 to 1500 characters)
                    </p>
                </div>

                <!-- Honeypot: hidden from people, bots tend to fill it -->
                <div class="hidden" aria-hidden="true">
                    <label for="website">Leave this empty</label>
                    <input
                        id="website"
                        type="text"
                        tabindex="-1"
                        autocomplete="off"
                    />
                </div>

                <!-- Consent -->
                <div>
                    <label class="flex items-start gap-3 text-muted text-sm">
                        <input
                            id="consent"
                            type="checkbox"
                            class="mt-1 h-4 w-4 shrink-0 accent-current"
                        />
                        <span>
                            I agree that GroverHQ may use my name, email and
                            phone number to contact me about this enquiry. See
                            the
                            <a
                                href="/privacy/"
                                class="text-accent hover:opacity-80 underline"
                                >website privacy notice</a
                            >.
                        </span>
                    </label>
                    <p id="error-consent" class="error-text hidden">
                        Please tick the box so we can contact you
                    </p>
                </div>

                <!-- Submit -->
                <div class="flex flex-col sm:flex-row gap-4 pt-2">
                    <!-- WhatsApp Button -->
                    <button
                        type="button"
                        onclick="sendWhatsApp()"
                        class="flex-1 border-2 border-border text-ink font-semibold py-3 rounded-lg hover:bg-bg hover:border-ink transition cursor-pointer"
                        aria-label="Send WhatsApp Message"
                    >
                        Send WhatsApp
                    </button>

                    <!-- Email Button -->
                    <button
                        type="button"
                        id="sendEmailBtn"
                        onclick="sendEmail()"
                        class="flex-1 bg-accent text-accent-ink font-semibold py-3 rounded-lg hover:opacity-90 transition cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
                        aria-label="Send Email"
                    >
                        Send Email
                    </button>
                </div>
            </form>

            <!-- Contact Info -->
            <div class="flex flex-col justify-center text-muted space-y-6">
                <p class="text-lg">Prefer direct contact? Reach out anytime.</p>

                <!-- Email -->
                <div>
                    <p class="text-ink font-medium mb-1">Email</p>
                    <a
                        href="mailto:info@groverhq.com"
                        class="flex items-center gap-2 text-accent font-medium hover:opacity-80 transition"
                    >
                        <!-- Envelope Icon -->
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="w-5 h-5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25H4.5a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5H4.5a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.5a2.25 2.25 0 01-2.28 0l-7.5-4.5A2.25 2.25 0 012.25 6.993V6.75"
                            ></path>
                        </svg>

                        info@groverhq.com →</a
                    >
                </div>

                <!-- WhatsApp -->
                <div>
                    <p class="text-ink font-medium mb-1">Phone / WhatsApp</p>
                    <a
                        href="https://wa.me/919878236480"
                        class="flex items-center gap-2 text-accent font-medium hover:opacity-80 transition"
                    >
                        <!-- Chat Bubble Icon -->
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="w-5 h-5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M8.25 9.75h7.5M8.25 12.75h4.5M4.5 6.75A2.25 2.25 0 016.75 4.5h10.5A2.25 2.25 0 0119.5 6.75v7.5A2.25 2.25 0 0117.25 16.5H9l-3.75 3v-12.75z"
                            ></path>
                        </svg>

                        9878236480 →</a
                    >
                </div>
            </div>
        </div>
    </div>

    <!-- Success Banner -->
    <div
        id="successBanner"
        class="hidden fixed top-6 right-6 bg-green-600 text-white px-6 py-3 rounded-lg shadow-lg transition-opacity duration-300"
    >
        Message sent successfully!
    </div>

    <!-- Error Banner -->
    <div
        id="errorBanner"
        class="hidden fixed top-6 right-6 bg-red-600 text-white px-6 py-3 rounded-lg shadow-lg transition-opacity duration-300"
    >
        Something went wrong. Please try again.
    </div>

    <!-- Validation + Send Script -->
    <script is:inline>
        // Returns a normalised phone string ("+91XXXXXXXXXX" / "+<cc><number>") or null.
        function normalizePhone(raw) {
            const cleaned = raw.trim().replace(/[\s\-().]/g, "");
            if (!/^\+?\d+$/.test(cleaned)) return null;

            if (cleaned.startsWith("+")) {
                const digits = cleaned.slice(1);
                if (digits.startsWith("91")) {
                    return /^91[6-9]\d{9}$/.test(digits) ? "+" + digits : null;
                }
                return /^[1-9]\d{7,14}$/.test(digits) ? "+" + digits : null;
            }

            // No "+": accept Indian mobiles only (9878236480, 09878236480, 919878236480)
            const m = cleaned.match(/^(?:91|0)?([6-9]\d{9})$/);
            return m ? "+91" + m[1] : null;
        }

        function validEmail(v) {
            const e = v.trim();
            return (
                e.length <= 254 &&
                /^[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}$/.test(
                    e,
                ) &&
                !e.includes("..")
            );
        }

        function validateFields() {
            const name = document.getElementById("name");
            const email = document.getElementById("email");
            const phone = document.getElementById("phone");
            const message = document.getElementById("message");
            const consent = document.getElementById("consent");

            const fields = [name, email, phone, message];
            const errors = {
                name: document.getElementById("error-name"),
                email: document.getElementById("error-email"),
                phone: document.getElementById("error-phone"),
                message: document.getElementById("error-message"),
                consent: document.getElementById("error-consent"),
            };

            let valid = true;
            const fail = (field, err) => {
                if (field) field.classList.add("input-error");
                err.classList.remove("hidden");
                valid = false;
            };

            // Reset
            fields.forEach((f) => f.classList.remove("input-error"));
            Object.values(errors).forEach((e) => e.classList.add("hidden"));

            if (name.value.trim().length < 2 || name.value.length > 80) fail(name, errors.name);
            if (!validEmail(email.value)) fail(email, errors.email);

            const normalizedPhone = normalizePhone(phone.value);
            if (!normalizedPhone) fail(phone, errors.phone);

            const msgLen = message.value.trim().length;
            if (msgLen < 5 || msgLen > 1500) fail(message, errors.message);
            if (!consent.checked) fail(null, errors.consent);

            if (!valid) return null;

            return {
                name: name.value.trim(),
                email: email.value.trim(),
                phone: normalizedPhone,
                message: message.value,
            };
        }

        function showBanner(type) {
            const success = document.getElementById("successBanner");
            const error = document.getElementById("errorBanner");

            if (type === "success") {
                success.classList.remove("hidden");
                success.style.opacity = "1";
                setTimeout(() => {
                    success.style.opacity = "0";
                    setTimeout(() => success.classList.add("hidden"), 300);
                }, 3000);
            }

            if (type === "error") {
                error.classList.remove("hidden");
                error.style.opacity = "1";
                setTimeout(() => {
                    error.style.opacity = "0";
                    setTimeout(() => error.classList.add("hidden"), 300);
                }, 3000);
            }
        }

        function sendWhatsApp() {
            const data = validateFields();
            if (!data) return;

            const whatsappNumber = "919878236480";
            const text = `New Inquiry from GroverHQ Website:

Name: ${data.name}
Email: ${data.email}
Phone: ${data.phone}
Message: ${data.message}`;

            const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
            window.open(url, "_blank");
        }

        async function sendEmail() {
            // Honeypot: silently pretend success to bots
            if (document.getElementById("website").value) {
                showBanner("success");
                return;
            }

            const data = validateFields();
            if (!data) return;

            const btn = document.getElementById("sendEmailBtn");
            if (btn.disabled) return;
            const label = btn.textContent;
            btn.disabled = true;
            btn.textContent = "Sending...";

            const formData = new FormData();
            formData.append("name", data.name);
            formData.append("email", data.email);
            formData.append("phone", data.phone);
            formData.append("message", data.message);
            formData.append("consent", "Agreed to be contacted");

            try {
                const response = await fetch(
                    "https://formspree.io/f/mojkwgno",
                    {
                        method: "POST",
                        body: formData,
                        headers: { Accept: "application/json" },
                    },
                );
                if (response.ok) {
                    showBanner("success");
                    document.getElementById("contactForm").reset();
                    updateCount();
                } else {
                    showBanner("error");
                }
            } catch (err) {
                showBanner("error");
            } finally {
                btn.disabled = false;
                btn.textContent = label;
            }
        }

        function updateCount() {
            const m = document.getElementById("message");
            document.getElementById("message-count").textContent =
                m.value.length + " / 1500";
        }
        document.getElementById("message").addEventListener("input", updateCount);
    </script>
</section>
