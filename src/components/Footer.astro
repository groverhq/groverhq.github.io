---
import SocialLinks from "./SocialLinks.astro";
import {
  CONTACT_INFO,
  NAV_LINKS,
  LOCATION_LINKS,
  SERVICE_VERTICAL_LINKS,
} from "../config";
---

<footer
  class="bg-neutral-950 text-neutral-400 py-12 px-8 border-t border-neutral-800 mt-24"
>
  <div
    class="max-w-6xl mx-auto flex flex-col lg:flex-row lg:items-start lg:gap-20"
  >
    <!-- Brand -->
    <div class="lg:w-1/4">
      <h3 class="text-white text-xl font-semibold mb-2">GroverHQ</h3>
      <p class="text-neutral-400 max-w-sm">
        Digital Solutions for Modern Businesses
        <br />
        — Web, Apps, Bots, Automation & AI.
      </p>

      <div class="mt-8 space-y-1 text-sm">
        <p>
          <a
            href="https://maps.app.goo.gl/aHfDMJcUiHEYdj1v5"
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-400 hover:text-blue-300 hover:underline transition"
          >
            {CONTACT_INFO.address}
          </a>
        </p>
        <p>
          <a
            href={`tel:+${CONTACT_INFO.phoneLink}`}
            class="text-blue-400 hover:text-blue-300 hover:underline transition"
          >
            {CONTACT_INFO.phone}
          </a>
        </p>
        <p>
          <a
            href={`mailto:${CONTACT_INFO.email}`}
            class="text-blue-400 hover:text-blue-300 hover:underline transition"
          >
            {CONTACT_INFO.email}
          </a>
        </p>
      </div>
    </div>

    <!-- Links + Social -->
    <div
      class="grid grid-cols-1 sm:grid-cols-4 gap-x-8 gap-y-10 lg:w-2/3 mt-12 lg:mt-0"
    >
      <!-- Company Links -->
      <div class="lg:pl-8">
        <h4 class="text-white font-medium mb-3">Company</h4>
        <ul class="space-y-2">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition">
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Locations -->
      <div>
        <h4 class="text-white font-medium mb-3">Locations</h4>
        <ul class="space-y-2">
          {
            LOCATION_LINKS.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition">
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Industries -->
      <div>
        <h4 class="text-white font-medium mb-3">Industries</h4>
        <ul class="space-y-2">
          {
            SERVICE_VERTICAL_LINKS.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition">
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Social Icons -->
      <div class="flex flex-col gap-4">
        <SocialLinks size="md" variant="dark" />
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div
    class="w-full text-center mt-12 pt-6 border-t border-neutral-800 text-sm text-neutral-400"
  >
    © {new Date().getFullYear()} GroverHQ. All rights reserved.
  </div>
</footer>
