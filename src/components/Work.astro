---
import { Image } from "astro:assets";
import LuthraDesktop from "../assets/luthra-desktop.png";
import LuthraMobile from "../assets/luthra-mobile.png";
import HeerDesktop from "../assets/heer-desktop.png";
import HeerMobile from "../assets/heer-mobile.png";
---

<section
  id="work"
  class="fade-up bg-surface text-ink py-24 px-6 lg:px-12 border-t border-border"
>
  <div class="max-w-6xl mx-auto">
    <!-- Heading -->
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4">Our Work</h2>
      <p class="text-muted text-lg max-w-2xl mx-auto">
        A growing collection of clean, fast, and scalable digital products built
        with precision and care.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Project 1: Luthra Interiors -->
      <div class="group">
        <h3 class="text-2xl font-semibold mb-2">Luthra Interiors Website</h3>
        <p class="text-ink mb-4">
          A modern, product‑focused interior brand website built with Astro and
          Cloudflare Pages. Designed for clarity, speed, and a premium browsing
          experience across all devices.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
          <div class="sm:col-span-3">
            <Image
              src={LuthraDesktop}
              alt="Luthra Interiors Desktop Screenshot"
              width={1600}
              format="png"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 50vw"
            />
          </div>
          <div class="flex justify-center sm:justify-start">
            <Image
              src={LuthraMobile}
              alt="Luthra Interiors Mobile Screenshot"
              width={600}
              format="png"
              sizes="(max-width: 640px) 40vw, 20vw"
            />
          </div>
        </div>

        <ul class="text-muted text-sm space-y-1 mb-4">
          <li>• Built with Astro, Tailwind, and Cloudflare Pages</li>
          <li>• Fully responsive with animation‑rich UI</li>
          <li>• Optimized for SEO, indexing, and fast performance</li>
        </ul>

        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          <a
            href="/work/luthra-interiors/"
            class="text-accent font-medium text-lg underline hover:opacity-80 transition"
          >
            Read Case Study →</a
          >
          <a
            href="https://luthrainteriors.com"
            target="_blank"
            class="text-muted font-medium text-lg underline hover:opacity-80 transition"
          >
            Visit Project →</a
          >
        </div>
      </div>

      <!-- Project 2: Heer Heart & Lung Clinic -->
      <div class="group">
        <h3 class="text-2xl font-semibold mb-2">
          Heer Heart &amp; Lung Clinic Website
        </h3>
        <p class="text-ink mb-4">
          A trust‑first website for Dr. Parvesh Grover's cardiology &amp;
          pulmonology super‑speciality clinic in Madhu Vihar, East Delhi. Built
          around appointment booking, WhatsApp enquiries, and live Google review
          integration.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
          <div class="sm:col-span-3">
            <Image
              src={HeerDesktop}
              alt="Heer Heart & Lung Clinic Desktop Screenshot"
              width={1600}
              format="png"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 50vw"
            />
          </div>
          <div class="flex justify-center sm:justify-start">
            <Image
              src={HeerMobile}
              alt="Heer Heart & Lung Clinic Mobile Screenshot"
              width={600}
              format="png"
              sizes="(max-width: 640px) 40vw, 20vw"
            />
          </div>
        </div>

        <ul class="text-muted text-sm space-y-1 mb-4">
          <li>• Built with Astro, deployed for a healthcare/clinic use case</li>
          <li>• One-click appointment booking and WhatsApp enquiry flow</li>
          <li>
            • Live Google Business review embed, service &amp; symptom pages
          </li>
        </ul>

        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          <a
            href="/work/heer-heart-lung-clinic/"
            class="text-accent font-medium text-lg underline hover:opacity-80 transition"
          >
            Read Case Study →</a
          >
          <a
            href="https://heermedcentre.in"
            target="_blank"
            class="text-muted font-medium text-lg underline hover:opacity-80 transition"
          >
            Visit Project →</a
          >
        </div>
      </div>
    </div>

    <!-- CTA Block -->
    <div
      class="mt-16 flex flex-col justify-center text-center border border-dashed border-border rounded-xl p-10"
    >
      <h3 class="text-xl font-semibold mb-3">Your Project Could Be Next</h3>
      <p class="text-muted mb-6">
        Want to be our next featured case study? Let's build something
        exceptional together.
      </p>
      <a
        href="/#contact"
        class="block sm:inline-block px-6 sm:px-8 py-3 bg-accent text-accent-ink font-medium rounded-full hover:opacity-90 transition w-full sm:w-auto text-center"
      >
        Start a Project</a
      >
    </div>
  </div>
</section>
