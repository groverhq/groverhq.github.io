---
import { Image } from "astro:assets";
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../../config";
import HeerDesktop from "../../assets/heer-desktop.png";
import HeerMobile from "../../assets/heer-mobile.png";

const pageTitle = "Heer Heart & Lung Clinic Website | GroverHQ Case Study";
const pageDescription =
  "How GroverHQ built a trust-first clinic website for Dr. Parvesh Grover's cardiology & pulmonology super-speciality clinic in Madhu Vihar, East Delhi.";

const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: "Heer Heart & Lung Clinic Website",
  creator: {
    "@type": "Organization",
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.url,
  },
  about: "Clinic and doctor website design",
  url: "https://heermedcentre.in",
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={caseStudySchema}
>
  <section class="py-24 px-6 lg:px-12 max-w-4xl mx-auto">
    <p class="mb-4">
      <a href="/work/" class="text-sm underline hover:opacity-70">← All work</a>
    </p>

    <h1 class="text-3xl lg:text-5xl font-bold mb-6">
      Heer Heart &amp; Lung Clinic Website
    </h1>

    <p class="text-gray-700 text-lg mb-6">
      Heer Heart &amp; Lung Super Speciality Clinic is Dr. Parvesh Grover's
      cardiology and pulmonology practice in Madhu Vihar, Patparganj, East
      Delhi. Chest symptoms rarely announce which organ they belong to —
      the site's core job was to communicate that one doctor, trained in
      both specialities, means one accurate diagnosis instead of two
      separate opinions, and to turn that trust into booked appointments.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 my-10">
      <div class="sm:col-span-3">
        <Image
          src={HeerDesktop}
          alt="Heer Heart & Lung Clinic Desktop Screenshot"
          width={1600}
          format="png"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 50vw"
        />
      </div>
      <div class="flex justify-center sm:justify-start">
        <Image
          src={HeerMobile}
          alt="Heer Heart & Lung Clinic Mobile Screenshot"
          width={600}
          format="png"
          sizes="(max-width: 640px) 40vw, 20vw"
        />
      </div>
    </div>

    <h2 class="text-2xl font-semibold mt-12 mb-4">What we built</h2>
    <ul class="text-gray-700 text-lg space-y-2 mb-8 list-disc pl-6">
      <li>Doctor profile and dual-speciality (cardiology + pulmonology) framing</li>
      <li>One-click appointment booking and a WhatsApp enquiry flow</li>
      <li>Live Google Business review embed for on-page trust signals</li>
      <li>Service and symptom-specific pages built for search visibility</li>
      <li>Fast, mobile-first build with Astro, since most patients search on their phone</li>
    </ul>

    <h2 class="text-2xl font-semibold mt-12 mb-4">Related</h2>
    <ul class="text-gray-700 text-lg space-y-2 mb-8 list-disc pl-6">
      <li>
        <a href="/services/web-design-for-clinics-doctors/" class="underline hover:opacity-70">
          Our website service for clinics &amp; doctors
        </a>
      </li>
      <li>
        <a href="/locations/delhi/" class="underline hover:opacity-70">
          More about our work in Delhi
        </a>
      </li>
    </ul>

    <div class="mt-4">
      <a
        href="https://heermedcentre.in"
        target="_blank"
        class="text-black font-medium text-lg underline hover:opacity-70 transition"
      >
        Visit Project →
      </a>
    </div>

    <div class="mt-16 border border-dashed border-gray-300 rounded-xl p-10 text-center">
      <h3 class="text-xl font-semibold mb-3">Your Project Could Be Next</h3>
      <a
        href="/#contact"
        class="inline-block px-8 py-3 bg-black text-white font-medium rounded-full hover:bg-gray-800 transition"
      >
        Start a Project
      </a>
    </div>
  </section>
</BaseLayout>