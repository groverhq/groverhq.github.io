---
import { Image } from "astro:assets";
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LuthraDesktop from "../../assets/luthra-desktop.png";
import LuthraMobile from "../../assets/luthra-mobile.png";
import HeerDesktop from "../../assets/heer-desktop.png";
import HeerMobile from "../../assets/heer-mobile.png";

const pageTitle = "Our Work | GroverHQ Case Studies";
const pageDescription =
  "See GroverHQ's client work — clinic websites, interior brand websites, and more. Built with Astro, Tailwind, and modern best practices for speed and SEO.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-24 px-6 lg:px-12 max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <h1 class="text-3xl lg:text-5xl font-bold mb-4">Our Work</h1>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        A growing collection of clean, fast, and scalable digital products
        built with precision and care.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Luthra Interiors -->
      <div class="group">
        <h2 id="luthra-interiors-website" class="text-2xl font-semibold mb-2">Luthra Interiors Website</h2>
        <p class="text-gray-700 mb-4">
          A modern, product‑focused interior brand website built with Astro
          and Cloudflare Pages. Designed for clarity, speed, and a premium
          browsing experience across all devices.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
          <div class="sm:col-span-3">
            <Image
              src={LuthraDesktop}
              alt="Luthra Interiors Desktop Screenshot"
              width={1600}
              format="png"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 50vw"
            />
          </div>
          <div class="flex justify-center sm:justify-start">
            <Image
              src={LuthraMobile}
              alt="Luthra Interiors Mobile Screenshot"
              width={600}
              format="png"
              sizes="(max-width: 640px) 40vw, 20vw"
            />
          </div>
        </div>

        <ul class="text-gray-600 text-sm space-y-1 mb-4">
          <li>• Built with Astro, Tailwind, and Cloudflare Pages</li>
          <li>• Fully responsive with animation‑rich UI</li>
          <li>• Optimized for SEO, indexing, and fast performance</li>
        </ul>

        <div class="mt-4">
          <a
            href="https://luthrainteriors.com"
            target="_blank"
            class="text-black font-medium text-lg underline hover:opacity-70 transition"
          >
            Visit Project →
          </a>
        </div>
      </div>

      <!-- Heer Heart & Lung Clinic -->
      <div class="group">
        <h2 id="heer-heart-lung-clinic-website" class="text-2xl font-semibold mb-2">
          Heer Heart &amp; Lung Clinic Website
        </h2>
        <p class="text-gray-700 mb-4">
          A trust‑first website for Dr. Parvesh Grover's cardiology &amp;
          pulmonology super‑speciality clinic in Madhu Vihar, East Delhi.
          Built around appointment booking, WhatsApp enquiries, and live
          Google review integration.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
          <div class="sm:col-span-3">
            <Image
              src={HeerDesktop}
              alt="Heer Heart & Lung Clinic Desktop Screenshot"
              width={1600}
              format="png"
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 50vw"
            />
          </div>
          <div class="flex justify-center sm:justify-start">
            <Image
              src={HeerMobile}
              alt="Heer Heart & Lung Clinic Mobile Screenshot"
              width={600}
              format="png"
              sizes="(max-width: 640px) 40vw, 20vw"
            />
          </div>
        </div>

        <ul class="text-gray-600 text-sm space-y-1 mb-4">
          <li>• Built with Astro, deployed for a healthcare/clinic use case</li>
          <li>• One-click appointment booking and WhatsApp enquiry flow</li>
          <li>• Live Google Business review embed, service &amp; symptom pages</li>
        </ul>

        <div class="mt-4">
          <a
            href="https://heermedcentre.in"
            target="_blank"
            class="text-black font-medium text-lg underline hover:opacity-70 transition"
          >
            Visit Project →
          </a>
        </div>
      </div>
    </div>

    <!-- CTA Block -->
    <div
      class="mt-16 flex flex-col justify-center text-center border border-dashed border-gray-300 rounded-xl p-10"
    >
      <h3 class="text-xl font-semibold mb-3">Your Project Could Be Next</h3>
      <p class="text-gray-600 mb-6">
        Want to be our next featured case study? Let's build something
        exceptional together.
      </p>
      <a
        href="/#contact"
        class="block sm:inline-block px-6 sm:px-8 py-3 bg-black text-white font-medium rounded-full hover:bg-gray-800 transition w-full sm:w-auto text-center"
      >
        Start a Project
      </a>
    </div>
  </section>
</BaseLayout>