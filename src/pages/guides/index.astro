---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../../config";
import { GUIDES } from "../../data/guides";
import { buildBreadcrumbSchema, buildWebPageSchema } from "../../utils/schema";

const title = "Guides: School ERP, Websites, Local SEO | GroverHQ";
const description =
    "Plain-English guides from GroverHQ: school ERP, website cost, Google Business Profile, clinic and interior designer websites, and CCTV on a Samsung TV.";

const schema = [
    buildWebPageSchema({ name: title, description, path: "/guides/", type: "CollectionPage" }),
    buildBreadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Guides", url: "/guides/" },
    ]),
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        itemListElement: GUIDES.map((g, i) => ({
            "@type": "ListItem",
            position: i + 1,
            url: `${SITE_CONFIG.url}/guides/${g.slug}/`,
            name: g.h1,
        })),
    },
];
---

<BaseLayout title={title} description={description} schema={schema}>
    <section class="py-24 px-6 lg:px-12 max-w-6xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span class="mx-2">/</span>
            <span class="text-ink">Guides</span>
        </nav>
        <h1 class="text-4xl lg:text-5xl font-bold mb-4">Guides</h1>
        <p class="text-muted text-lg mb-12 max-w-2xl">
            Practical, plain-English guides for schools and local businesses.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                GUIDES.map((g) => (
                    <a
                        href={`/guides/${g.slug}/`}
                        class="block p-6 bg-surface border border-border rounded-xl hover:border-accent transition"
                    >
                        <h2 class="text-xl font-semibold mb-2">{g.h1}</h2>
                        <p class="text-muted">{g.description}</p>
                    </a>
                ))
            }
        </div>
    </section>
</BaseLayout>
