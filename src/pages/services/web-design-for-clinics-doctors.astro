---
import { Image } from "astro:assets";
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../../config";
import { buildBreadcrumbSchema, buildFAQSchema } from "../../utils/schema";
import HeerDesktop from "../../assets/heer-desktop.png";
import HeerMobile from "../../assets/heer-mobile.png";

const pageTitle = "Website Design for Clinics & Doctors | GroverHQ";
const pageDescription =
    "GroverHQ builds trust-first websites for clinics, doctors, and healthcare practices — appointment booking, WhatsApp enquiries, and Google review integration. See our work for Heer Heart & Lung Clinic, Delhi.";

const faqs = [
    {
        question: "Do you have experience building clinic websites?",
        answer: "Yes — Heer Heart & Lung Super Speciality Clinic in Madhu Vihar, East Delhi is a live example, with appointment booking, WhatsApp enquiries, and Google review integration built in from day one.",
    },
    {
        question: "Can patients book appointments directly on the site?",
        answer: "Yes, one-click appointment booking and a WhatsApp-first enquiry flow are standard parts of what we build for clinics and doctors.",
    },
    {
        question: "How much does a clinic website cost?",
        answer: "Business websites start at ₹40,000. Appointment booking, WhatsApp integration, and review embeds are scoped and priced based on what the clinic needs — see our full services and pricing page for details.",
    },
];

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Website Design for Clinics and Doctors",
    provider: {
        "@type": "Organization",
        name: SITE_CONFIG.name,
        url: SITE_CONFIG.url,
    },
    areaServed: ["India", "Delhi NCR", "Mohali", "Chandigarh", "Panchkula"],
    description: pageDescription,
};

const breadcrumbSchema = buildBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Services", url: "/services/" },
    {
        name: "Clinics & Doctors",
        url: "/services/web-design-for-clinics-doctors/",
    },
]);

const faqSchema = buildFAQSchema(faqs);
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    schema={[serviceSchema, breadcrumbSchema, faqSchema]}
>
    <section class="py-24 px-6 lg:px-12 max-w-4xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span class="mx-2">/</span>
            <a href="/services/" class="hover:text-accent transition"
                >Services</a
            >
            <span class="mx-2">/</span>
            <span class="text-ink">Clinics &amp; Doctors</span>
        </nav>

        <h1 class="text-3xl lg:text-5xl font-bold mb-6">
            Website Design for Clinics &amp; Doctors
        </h1>

        <p class="text-ink text-lg mb-6">
            A clinic website has one job above all others: turn a visitor into a
            booked appointment, without making them wait on hold or hunt for a
            phone number. We build clinic and doctor websites around that single
            goal — clear symptoms-to-specialist framing, one-click appointment
            booking, a WhatsApp enquiry flow patients actually use, and live
            Google review integration so trust is visible on the first screen.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 my-10">
            <div class="sm:col-span-3">
                <Image
                    src={HeerDesktop}
                    alt="Heer Heart & Lung Clinic Desktop Screenshot"
                    width={1600}
                    format="png"
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 50vw"
                />
            </div>
            <div class="flex justify-center sm:justify-start">
                <Image
                    src={HeerMobile}
                    alt="Heer Heart & Lung Clinic Mobile Screenshot"
                    width={600}
                    format="png"
                    sizes="(max-width: 640px) 40vw, 20vw"
                />
            </div>
        </div>

        <h2 class="text-2xl font-semibold mt-12 mb-4">What's included</h2>
        <ul class="text-ink text-lg space-y-2 mb-8 list-disc pl-6">
            <li>
                Doctor profile, specialities, and credentials laid out clearly
            </li>
            <li>Appointment booking and WhatsApp-first enquiry flow</li>
            <li>Live Google Business review embed</li>
            <li>Service and symptom-specific pages for search visibility</li>
            <li>
                Fast, mobile-first build — most patients search on their phone
            </li>
        </ul>

        <h2 class="text-2xl font-semibold mt-12 mb-4">Case study</h2>
        <p class="text-ink text-lg mb-4">
            <a
                href="/work/heer-heart-lung-clinic/"
                class="text-accent underline hover:opacity-80"
            >
                Heer Heart &amp; Lung Super Speciality Clinic</a
            >
            — Dr. Parvesh Grover's cardiology &amp; pulmonology practice in Madhu
            Vihar, East Delhi. Built with appointment booking, WhatsApp enquiries,
            and live review integration from day one. (<a
                href="https://heermedcentre.in"
                target="_blank"
                class="text-accent underline hover:opacity-80"
                >visit heermedcentre.in →</a
            >)
        </p>

        <p class="text-ink text-lg mb-6">
            Building or based in Mohali, Chandigarh, or Panchkula instead? See
            our
            <a
                href="/locations/mohali/"
                class="text-accent underline hover:opacity-80"
            >
                Mohali</a
            >,
            <a
                href="/locations/chandigarh/"
                class="text-accent underline hover:opacity-80"
            >
                Chandigarh</a
            >, and
            <a
                href="/locations/panchkula/"
                class="text-accent underline hover:opacity-80"
            >
                Panchkula</a
            >
            pages for local project examples and service details.
        </p>

        <h2 class="text-2xl font-semibold mt-12 mb-4">
            Frequently Asked Questions
        </h2>
        <div class="space-y-6 mb-8">
            {
                faqs.map((faq) => (
                    <div class="border-b border-border pb-6">
                        <h3 class="font-semibold text-lg mb-2">
                            {faq.question}
                        </h3>
                        <p class="text-muted">{faq.answer}</p>
                    </div>
                ))
            }
        </div>

        <div
            class="mt-16 border border-dashed border-border rounded-xl p-10 text-center"
        >
            <h3 class="text-xl font-semibold mb-3">
                Running a clinic or practice that needs a website?
            </h3>
            <a
                href="/#contact"
                class="inline-block px-8 py-3 bg-accent text-accent-ink font-medium rounded-full hover:opacity-90 transition"
            >
                Start a Project</a
            >
        </div>
    </section>
</BaseLayout>
