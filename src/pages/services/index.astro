---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SERVICE_VERTICAL_LINKS, LOCATION_LINKS } from "../../config";
import {
    buildBreadcrumbSchema,
    buildWebPageSchema,
} from "../../utils/schema";
import PriceCard from "../../components/PriceCard.astro";
import PackagesStrip from "../../components/PackagesStrip.astro";
import FeaturedStrip from "../../components/FeaturedStrip.astro";
import { ADS_SERVICES, buildCatalogSchema, inr } from "../../data/pricing";
import { CATALOG } from "../../data/services-catalog";
import { SITE_CONFIG } from "../../config";

const pageTitle = "GroverHQ Services: Websites, Ads, Automation & AI";
const pageDescription =
    "All GroverHQ services with pricing: websites, Google & Meta Ads, automation, CRM, integrations, internal tools, industry systems and AI workflows.";

const breadcrumbSchema = buildBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Services", url: "/services/" },
]);

const webPageSchema = buildWebPageSchema({
    name: pageTitle,
    description: pageDescription,
    path: "/services/",
    type: "CollectionPage",
});

// Generic "starts from" pricing on this page: no list price / MRP in the schema.
const catalogSchema = buildCatalogSchema(
    `${SITE_CONFIG.url}/services/`,
    {
        "@type": "Organization",
        name: SITE_CONFIG.name,
        url: SITE_CONFIG.url,
    },
    false,
);
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    schema={[webPageSchema, breadcrumbSchema, catalogSchema]}
>
    <section class="bg-bg text-ink pt-24 px-6 lg:px-12">
        <div class="max-w-6xl mx-auto">
            <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
                <a href="/" class="hover:text-accent transition">Home</a>
                <span class="mx-2">/</span>
                <span class="text-ink">Services</span>
            </nav>

            <!-- Heading -->
            <div class="text-center mb-16">
                <h1 class="text-4xl lg:text-6xl font-bold mb-4">
                    Our Services
                </h1>
                <p class="text-muted text-lg max-w-2xl mx-auto">
                    A complete list of all digital solutions we offer — from
                    websites to automation, AI, CRM, internal tools, and
                    industry-ready systems.
                </p>
                <p class="text-muted text-base mt-4">
                    Prefer a bundled starting point instead? See our
                    <a
                        href="/packages/"
                        class="text-accent underline hover:opacity-80"
                        >most popular packages</a
                    >.
                </p>
            </div>

            <!-- TOC -->
            <nav class="mb-16">
                <ul
                    class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-9 gap-4"
                >
                    <li>
                        <a
                            href="#websites"
                            class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                        >
                            Websites</a
                        >
                    </li>

                    <li>
                        <a
                            href="#ads"
                            class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                        >
                            Ads & Leads</a
                        >
                    </li>

                    <li>
                        <a
                            href="#selling"
                            class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                        >
                            Online Selling</a
                        >
                    </li>

                    <li>
                        <a
                            href="#crm"
                            class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                        >
                            CRM</a
                        >
                    </li>

                    <li>
                        <a
                            href="#operations"
                            class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                        >
                            Operations</a
                        >
                    </li>

                    <li>
                        <a
                            href="#industry"
                            class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                        >
                            Industry Systems</a
                        >
                    </li>

                    <li>
                        <a
                            href="#automation"
                            class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                        >
                            Automation</a
                        >
                    </li>

                    <li>
                        <a
                            href="#integrations"
                            class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                        >
                            Integrations</a
                        >
                    </li>

                    <li>
                        <a
                            href="#admin"
                            class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                        >
                            Admin Tools</a
                        >
                    </li>
                </ul>
            </nav>

            <!-- PDF Download -->
            <div class="flex justify-center mt-10">
                <a
                    href="/GroverHQ_Services_Full.pdf"
                    target="_blank"
                    class="px-8 py-4 bg-accent text-accent-ink rounded-lg font-medium hover:opacity-90 transition-all duration-200"
                >
                    Download Full Services Menu (PDF)</a
                >
            </div>

            <p class="text-center text-muted mt-6">
                Building for a school or institute? See our
                <a
                    href="/services/school-management-system/"
                    class="text-accent underline hover:opacity-80"
                    >School Management System</a
                >.
            </p>

            <div class="mt-24 space-y-20">
                {
                    CATALOG.filter((c) => c.id === "websites").map((sec) => (
                        <section
                            id={sec.id}
                            class="fade-up p-8 bg-surface rounded-2xl border border-border mb-12 transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
                        >
                            <h2 class="text-3xl font-bold mb-2">{sec.title}</h2>
                            <div class="h-1 w-20 bg-accent mb-8" />
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                                {sec.items.map((item) => (
                                    <div>
                                        <h3 class="font-semibold">
                                            {item.name}{" "}
                                            <span class="text-muted text-sm">
                                                {inr(item.price)}+
                                            </span>
                                        </h3>
                                        <p class="text-muted text-sm">{item.blurb}</p>
                                    </div>
                                ))}
                            </div>
                        </section>
                    ))
                }

                <section
                    id="ads"
                    class="fade-up p-8 bg-surface rounded-2xl border border-border mb-12 transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
                >
                    <h2 class="text-3xl font-bold mb-2">
                        Ads & Lead Generation
                    </h2>
                    <div class="h-1 w-20 bg-accent mb-4"></div>
                    <p class="text-muted text-sm mb-8">
                        Ad budget is separate and paid directly to Google/Meta.
                        Follow-up automation, review automation, WhatsApp
                        Business setup and CRM are listed in their sections
                        below.
                    </p>

                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
                    >
                        {
                            ADS_SERVICES.filter(
                                (i) => i.id !== "landing-pages",
                            ).map((item) => <PriceCard item={item} showMrp={false} />)
                        }
                    </div>
                    <p class="text-muted text-sm mt-6">
                        Landing pages for campaigns are listed under Websites &
                        Online Presence.
                    </p>
                </section>

                {
                    CATALOG.filter((c) => c.id !== "websites").map((sec) => (
                        <section
                            id={sec.id}
                            class="fade-up p-8 bg-surface rounded-2xl border border-border mb-12 transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
                        >
                            <h2 class="text-3xl font-bold mb-2">{sec.title}</h2>
                            <div class="h-1 w-20 bg-accent mb-8" />
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                                {sec.items.map((item) => (
                                    <div>
                                        <h3 class="font-semibold">
                                            {item.name}{" "}
                                            <span class="text-muted text-sm">
                                                {inr(item.price)}+
                                            </span>
                                        </h3>
                                        <p class="text-muted text-sm">{item.blurb}</p>
                                    </div>
                                ))}
                            </div>
                        </section>
                    ))
                }
            </div>

            <!-- Packages cross-link -->
            <PackagesStrip class="mt-4" />
            <FeaturedStrip class="mt-4" />

            <!-- By Industry -->
            <div class="mt-24">
                <div class="text-center mb-10">
                    <h2 class="text-3xl font-bold mb-2">By Industry</h2>
                    <p class="text-muted max-w-2xl mx-auto">
                        Specialized website builds for industries we've already
                        shipped real, live projects in.
                    </p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    {
                        SERVICE_VERTICAL_LINKS.map((link) => (
                            <a
                                href={link.href}
                                class="block p-8 bg-surface border border-border rounded-xl hover:border-accent hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
                            >
                                <h3 class="text-xl font-semibold mb-2">
                                    {link.name}
                                </h3>
                                <p class="text-muted text-sm">
                                    See the case study and what's included →
                                </p>
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- Where We Work -->
            <div class="mt-20 pb-24">
                <div class="text-center mb-10">
                    <h2 class="text-3xl font-bold mb-2">Where We Work</h2>
                    <p class="text-muted max-w-2xl mx-auto">
                        Based in Mohali, serving the tricity and Delhi NCR.
                    </p>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    {
                        LOCATION_LINKS.map((link) => (
                            <a
                                href={link.href}
                                class="flex items-center justify-center h-16 px-3 text-center leading-tight
                bg-surface rounded-xl border border-border
                hover:border-accent hover:-translate-y-0.5 transition-all duration-200 text-sm font-medium"
                            >
                                {link.name}
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </section>
    <section class="fade-up p-12 bg-accent text-accent-ink text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Start Your Project?</h2>
        <p class="text-accent-ink/80 mb-8">
            Let's build something modern, fast and reliable for your business.
        </p>

        <a
            href="/#contact"
            class="inline-block px-8 py-4 bg-bg text-ink rounded-md font-medium hover:opacity-90 transition"
        >
            Start a Project</a
        >
    </section>
</BaseLayout>
