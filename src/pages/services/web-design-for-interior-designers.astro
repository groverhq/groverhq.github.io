---
import { Image } from "astro:assets";
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../../config";
import { buildBreadcrumbSchema, buildFAQSchema } from "../../utils/schema";
import LuthraDesktop from "../../assets/luthra-desktop.png";
import LuthraMobile from "../../assets/luthra-mobile.png";

const pageTitle = "Website Design for Interior Designers | GroverHQ";
const pageDescription =
    "GroverHQ builds product-focused, premium websites for interior designers and interior brands — fast, gallery-driven, and built to convert browsers into showroom visits. See our work for Luthra Interiors.";

const faqs = [
    {
        question: "Do you have experience building interior brand websites?",
        answer: "Yes — Luthra Interiors, a WPC panels, decorative sheets, and wallpapers showroom in Sector 82, Mohali, is a live example of our work: fast, product-focused, and gallery-driven.",
    },
    {
        question: "Can the site help drive showroom visits, not just browsing?",
        answer: "Yes — we build a clear path from browsing a product gallery to booking a showroom visit or consultation, with WhatsApp enquiry integration built in.",
    },
    {
        question: "How much does an interior brand website cost?",
        answer: "Business websites start at ₹40,000, and product catalogs with filters and galleries start at ₹50,000. See our full services and pricing page for exact scope.",
    },
];

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Website Design for Interior Designers",
    provider: {
        "@type": "Organization",
        name: SITE_CONFIG.name,
        url: SITE_CONFIG.url,
    },
    areaServed: ["India", "Mohali", "Chandigarh", "Panchkula", "Delhi NCR"],
    description: pageDescription,
};

const breadcrumbSchema = buildBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Services", url: "/services/" },
    {
        name: "Interior Designers",
        url: "/services/web-design-for-interior-designers/",
    },
]);

const faqSchema = buildFAQSchema(faqs);
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    schema={[serviceSchema, breadcrumbSchema, faqSchema]}
>
    <section class="py-24 px-6 lg:px-12 max-w-4xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span class="mx-2">/</span>
            <a href="/services/" class="hover:text-accent transition"
                >Services</a
            >
            <span class="mx-2">/</span>
            <span class="text-ink">Interior Designers</span>
        </nav>

        <h1 class="text-3xl lg:text-5xl font-bold mb-6">
            Website Design for Interior Designers
        </h1>

        <p class="text-ink text-lg mb-6">
            An interior brand's website has to do what a showroom does — let the
            work speak first. We build product-focused, gallery-driven sites
            that load fast, look premium on any device, and give visitors a
            clear path from browsing a gallery to booking a showroom visit or
            consultation.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 my-10">
            <div class="sm:col-span-3">
                <Image
                    src={LuthraDesktop}
                    alt="Luthra Interiors Desktop Screenshot"
                    width={1600}
                    format="png"
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 50vw"
                />
            </div>
            <div class="flex justify-center sm:justify-start">
                <Image
                    src={LuthraMobile}
                    alt="Luthra Interiors Mobile Screenshot"
                    width={600}
                    format="png"
                    sizes="(max-width: 640px) 40vw, 20vw"
                />
            </div>
        </div>

        <h2 class="text-2xl font-semibold mt-12 mb-4">What's included</h2>
        <ul class="text-ink text-lg space-y-2 mb-8 list-disc pl-6">
            <li>Category and product galleries built for fast browsing</li>
            <li>Showroom visit / consultation booking flow</li>
            <li>WhatsApp enquiry integration</li>
            <li>
                Mobile-first, animation-rich UI without sacrificing load speed
            </li>
            <li>
                SEO structure built for local "interior designer near me"
                searches
            </li>
        </ul>

        <h2 class="text-2xl font-semibold mt-12 mb-4">Case study</h2>
        <p class="text-ink text-lg mb-4">
            <a
                href="/work/luthra-interiors/"
                class="text-accent underline hover:opacity-80"
            >
                Luthra Interiors</a
            >
            — a modern, product-focused interior brand website built with Astro and
            Cloudflare Pages, covering WPC panels, 3D wall panels, decorative sheets,
            and wallpapers, with a fully responsive, animation-rich UI optimised for
            speed and SEO. (<a
                href="https://luthrainteriors.com"
                target="_blank"
                class="text-accent underline hover:opacity-80"
                >visit luthrainteriors.com →</a
            >)
        </p>

        <p class="text-ink text-lg mb-6">
            Based in Delhi instead? See our
            <a
                href="/locations/delhi/"
                class="text-accent underline hover:opacity-80"
            >
                Delhi</a
            >
            page, or explore our
            <a
                href="/services/web-design-for-clinics-doctors/"
                class="text-accent underline hover:opacity-80"
            >
                clinic &amp; doctor website service</a
            >
            if healthcare is closer to your industry.
        </p>

        <h2 class="text-2xl font-semibold mt-12 mb-4">
            Frequently Asked Questions
        </h2>
        <div class="space-y-6 mb-8">
            {
                faqs.map((faq) => (
                    <div class="border-b border-border pb-6">
                        <h3 class="font-semibold text-lg mb-2">
                            {faq.question}
                        </h3>
                        <p class="text-muted">{faq.answer}</p>
                    </div>
                ))
            }
        </div>

        <div
            class="mt-16 border border-dashed border-border rounded-xl p-10 text-center"
        >
            <h3 class="text-xl font-semibold mb-3">
                Building a website for your interior brand or showroom?
            </h3>
            <a
                href="/#contact"
                class="inline-block px-8 py-3 bg-accent text-accent-ink font-medium rounded-full hover:opacity-90 transition"
            >
                Start a Project</a
            >
        </div>
    </section>
</BaseLayout>
