---
import "../../styles/global.css";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CAMERA_VIEWER } from "../../config";
import { buildBreadcrumbSchema } from "../../utils/schema";
import liveSdPrice from "../../assets/camera-viewer/live-sd-price.jpg";

const title = "Apps by GroverHQ | Camera Viewer for Samsung TV";
const description =
  "Apps built by GroverHQ, including GroverHQ Camera Viewer for Samsung Smart TVs: watch your IP cameras, CCTV and NVR live on the big screen.";
const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Apps", url: "/apps/" },
]);
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/apps/camera-viewer/og.jpg"
  schema={breadcrumb}
>
  <section class="py-24 px-6 lg:px-12 max-w-4xl mx-auto">
    <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
      <a href="/" class="hover:text-accent transition">Home</a>
      <span class="mx-2">/</span>
      <span class="text-ink">Apps</span>
    </nav>

    <h1 class="text-3xl lg:text-5xl font-bold mb-6">Apps</h1>
    <p class="text-muted text-lg mb-10">
      Products we build and run ourselves, alongside our work for clients.
    </p>

    <a
      href={CAMERA_VIEWER.path}
      class="block bg-surface border border-border rounded-xl overflow-hidden hover:border-accent transition-all duration-300"
    >
      <Image
        src={liveSdPrice}
        alt="GroverHQ Camera Viewer live view on a Samsung TV"
        width={960}
        format="webp"
        loading="lazy"
        class="w-full h-auto"
      />
      <div class="p-8">
        <h2 class="text-xl font-semibold mb-2">{CAMERA_VIEWER.name}</h2>
        <p class="text-muted">
          {CAMERA_VIEWER.tagline} Works with CP Plus, Hikvision, Dahua and other
          RTSP/ONVIF cameras. Free, with an optional HD unlock.
        </p>
      </div>
    </a>
  </section>
</BaseLayout>
