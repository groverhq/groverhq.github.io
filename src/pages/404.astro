---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Page Not Found | GroverHQ"
    description="This page doesn't exist — but here's where you probably meant to go."
    noindex={true}
>
    <section class="py-20 px-6 lg:px-12 max-w-2xl mx-auto text-center">
        <p class="text-accent font-semibold text-lg mb-3">404</p>
        <h1 class="text-3xl lg:text-4xl font-bold mb-4">Page Not Found</h1>
        <p class="text-muted text-lg mb-10">
            That page doesn't exist, may have moved, or the link has a typo.
            Here's where you probably meant to go.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10 text-left">
            <a
                href="/work/"
                class="p-6 bg-surface border border-border rounded-xl hover:border-accent transition"
            >
                <h2 class="font-semibold mb-1">Our Work</h2>
                <p class="text-muted text-sm">Case studies from real clients</p>
            </a>
            <a
                href="/services/"
                class="p-6 bg-surface border border-border rounded-xl hover:border-accent transition"
            >
                <h2 class="font-semibold mb-1">Services</h2>
                <p class="text-muted text-sm">
                    Everything we build, with pricing
                </p>
            </a>
            <a
                href="/locations/"
                class="p-6 bg-surface border border-border rounded-xl hover:border-accent transition"
            >
                <h2 class="font-semibold mb-1">Locations</h2>
                <p class="text-muted text-sm">
                    Mohali, Chandigarh, Panchkula, Delhi
                </p>
            </a>
        </div>

        <a
            href="/"
            class="inline-block px-8 py-3 bg-accent text-accent-ink font-medium rounded-full hover:opacity-90 transition"
        >
            Back to Homepage
        </a>
        <p class="mt-4">
            <a
                href="/#contact"
                class="text-muted text-sm hover:text-accent transition"
            >
                or get in touch
            </a>
        </p>
    </section>
</BaseLayout>
