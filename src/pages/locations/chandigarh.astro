---
import { Image } from "astro:assets";
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_CONFIG } from "../../config";
import { buildBreadcrumbSchema, buildFAQSchema } from "../../utils/schema";
import LuthraDesktop from "../../assets/luthra-desktop.png";
import LuthraMobile from "../../assets/luthra-mobile.png";

const pageTitle = "Website Design & Development in Chandigarh | GroverHQ";
const pageDescription =
    "GroverHQ builds fast, modern websites for businesses in Chandigarh and the wider tricity area, working closely with clients from our Mohali base.";

const faqs = [
    {
        question: "Are you based in Chandigarh?",
        answer: "We're based in Mohali, right next to Chandigarh, and treat the tricity as our everyday service area — in-person meetings and site visits are easy to arrange whenever a project calls for it.",
    },
    {
        question: "Have you built websites for Chandigarh-based businesses?",
        answer: "Our client Luthra Interiors, based in Sector 82, Mohali, explicitly serves Chandigarh alongside Mohali and Punjab, and we built their website. We're equally set up to work directly with a Chandigarh-based business.",
    },
    {
        question: "What's included in a business website?",
        answer: "Business websites start at ₹40,000 and are modern, fast, and SEO-ready. See our full services and pricing page for exact scope and pricing on add-ons like booking and WhatsApp integration.",
    },
];

const locationSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Website Design & Development",
    provider: {
        "@type": "Organization",
        name: SITE_CONFIG.name,
        url: SITE_CONFIG.url,
    },
    areaServed: {
        "@type": "City",
        name: "Chandigarh",
    },
    description: pageDescription,
};

const breadcrumbSchema = buildBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations/" },
    { name: "Chandigarh", url: "/locations/chandigarh/" },
]);

const faqSchema = buildFAQSchema(faqs);
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    schema={[locationSchema, breadcrumbSchema, faqSchema]}
>
    <section class="py-24 px-6 lg:px-12 max-w-4xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
            <a href="/" class="hover:text-accent transition">Home</a>
            <span class="mx-2">/</span>
            <a href="/locations/" class="hover:text-accent transition"
                >Locations</a
            >
            <span class="mx-2">/</span>
            <span class="text-ink">Chandigarh</span>
        </nav>

        <h1 class="text-3xl lg:text-5xl font-bold mb-6">
            Website Design &amp; Development in Chandigarh
        </h1>

        <p class="text-ink text-lg mb-6">
            GroverHQ is based just across the border in Mohali, and Chandigarh
            is part of our everyday service area — close enough for in-person
            meetings, showroom visits, or site walkthroughs whenever a project
            needs it. One of our clients,
            <a
                href="/work/luthra-interiors/"
                class="text-accent underline hover:opacity-80"
            >
                Luthra Interiors</a
            >, explicitly lists Chandigarh as part of the region they serve
            alongside Mohali and Punjab.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 my-10">
            <div class="sm:col-span-3">
                <Image
                    src={LuthraDesktop}
                    alt="Luthra Interiors Desktop Screenshot"
                    width={1600}
                    format="png"
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 50vw"
                />
            </div>
            <div class="flex justify-center sm:justify-start">
                <Image
                    src={LuthraMobile}
                    alt="Luthra Interiors Mobile Screenshot"
                    width={600}
                    format="png"
                    sizes="(max-width: 640px) 40vw, 20vw"
                />
            </div>
        </div>

        <h2 class="text-2xl font-semibold mt-12 mb-4">
            What we build for Chandigarh-based clients
        </h2>
        <ul class="text-ink text-lg space-y-2 mb-8 list-disc pl-6">
            <li>
                Interior, retail &amp; showroom websites — see our
                <a
                    href="/services/web-design-for-interior-designers/"
                    class="text-accent underline hover:opacity-80"
                >
                    interior designer website service</a
                >
            </li>
            <li>
                Clinic &amp; doctor websites — see our
                <a
                    href="/services/web-design-for-clinics-doctors/"
                    class="text-accent underline hover:opacity-80"
                >
                    clinic/doctor website service</a
                >
            </li>
            <li>Business websites and landing pages</li>
            <li>Booking, enquiry, and WhatsApp-first lead capture flows</li>
        </ul>

        <p class="text-ink text-lg mb-6">
            Based in Mohali or Panchkula instead? See our
            <a
                href="/locations/mohali/"
                class="text-accent underline hover:opacity-80"
            >
                Mohali</a
            >
            and
            <a
                href="/locations/panchkula/"
                class="text-accent underline hover:opacity-80"
            >
                Panchkula</a
            >
            pages.
        </p>

        <h2 class="text-2xl font-semibold mt-12 mb-4">
            Frequently Asked Questions
        </h2>
        <div class="space-y-6 mb-8">
            {
                faqs.map((faq) => (
                    <div class="border-b border-border pb-6">
                        <h3 class="font-semibold text-lg mb-2">
                            {faq.question}
                        </h3>
                        <p class="text-muted">{faq.answer}</p>
                    </div>
                ))
            }
        </div>

        <div
            class="mt-16 border border-dashed border-border rounded-xl p-10 text-center"
        >
            <h3 class="text-xl font-semibold mb-3">
                Building a website for your Chandigarh business?
            </h3>
            <a
                href="/#contact"
                class="inline-block px-8 py-3 bg-accent text-accent-ink font-medium rounded-full hover:opacity-90 transition"
            >
                Start a Project</a
            >
        </div>
    </section>
</BaseLayout>
