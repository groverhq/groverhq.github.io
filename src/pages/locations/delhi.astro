---
import { Image } from "astro:assets";
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT_INFO, SITE_CONFIG } from "../../config";
import { buildBreadcrumbSchema, buildFAQSchema } from "../../utils/schema";
import HeerDesktop from "../../assets/heer-desktop.png";
import HeerMobile from "../../assets/heer-mobile.png";

const pageTitle = "Website Design & Development in Delhi | GroverHQ";
const pageDescription =
  "GroverHQ builds fast, conversion-focused websites for clinics, doctors, and local businesses in Delhi NCR — including our clinic website for Heer Heart & Lung Super Speciality Clinic in Madhu Vihar, East Delhi.";

const faqs = [
  {
    question: "Do you work with clients remotely in Delhi?",
    answer:
      "Yes — our Heer Heart & Lung Clinic project in Madhu Vihar, East Delhi was built entirely through remote calls, screen-shares, and async updates. We're based in Mohali, but distance hasn't been an obstacle for Delhi NCR clients.",
  },
  {
    question: "Do you build websites for clinics and doctors specifically?",
    answer:
      "Yes — appointment booking, WhatsApp enquiry flows, and Google review integration are all things we've built and shipped for a real clinic client. See our clinic & doctor website service for details.",
  },
  {
    question: "How much does a clinic website cost?",
    answer:
      "Business websites start at ₹40,000, with add-ons like appointment booking and WhatsApp integration priced separately depending on scope. See our full services and pricing page for exact figures.",
  },
];

const locationSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Website Design & Development",
  provider: {
    "@type": "Organization",
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.url,
  },
  areaServed: {
    "@type": "City",
    name: "Delhi",
  },
  description: pageDescription,
};

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Locations", url: "/locations/" },
  { name: "Delhi", url: "/locations/delhi/" },
]);

const faqSchema = buildFAQSchema(faqs);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[locationSchema, breadcrumbSchema, faqSchema]}
>
  <section class="py-24 px-6 lg:px-12 max-w-4xl mx-auto">
    <nav aria-label="Breadcrumb" class="text-sm text-muted mb-6">
      <a href="/" class="hover:text-accent transition">Home</a>
      <span class="mx-2">/</span>
      <a href="/locations/" class="hover:text-accent transition">Locations</a>
      <span class="mx-2">/</span>
      <span class="text-ink">Delhi</span>
    </nav>

    <h1 class="text-3xl lg:text-5xl font-bold mb-6">
      Website Design &amp; Development in Delhi
    </h1>

    <p class="text-ink text-lg mb-6">
      We've built and shipped a live clinic website for a Delhi-based client —
      Dr. Parvesh Grover's
      <a
        href="/work/heer-heart-lung-clinic/"
        class="text-accent underline hover:opacity-80"
        >Heer Heart &amp; Lung Super Speciality Clinic</a
      >
      in Madhu Vihar, Patparganj, East Delhi — handling everything from appointment
      booking to WhatsApp enquiries and live Google review integration. If you run
      a clinic, practice, or local business in Delhi NCR, that's the kind of result
      you can expect.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 my-10">
      <div class="sm:col-span-3">
        <Image
          src={HeerDesktop}
          alt="Heer Heart & Lung Clinic Desktop Screenshot"
          width={1600}
          format="png"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 50vw"
        />
      </div>
      <div class="flex justify-center sm:justify-start">
        <Image
          src={HeerMobile}
          alt="Heer Heart & Lung Clinic Mobile Screenshot"
          width={600}
          format="png"
          sizes="(max-width: 640px) 40vw, 20vw"
        />
      </div>
    </div>

    <p class="text-ink text-lg mb-6">
      GroverHQ is based in {CONTACT_INFO.city}, {CONTACT_INFO.state}, and we
      work remotely with clients across Delhi NCR — calls, screen-shares, and
      async updates make distance a non-issue for a website project.
    </p>

    <h2 class="text-2xl font-semibold mt-12 mb-4">
      What we build for Delhi-based clients
    </h2>
    <ul class="text-ink text-lg space-y-2 mb-8 list-disc pl-6">
      <li>
        Clinic &amp; doctor websites — see our
        <a
          href="/services/web-design-for-clinics-doctors/"
          class="text-accent underline hover:opacity-80"
        >
          clinic/doctor website service</a
        >
      </li>
      <li>Business websites and landing pages</li>
      <li>Booking, enquiry, and WhatsApp-first lead capture flows</li>
      <li>Local SEO and Google Business optimisation</li>
    </ul>

    <h2 class="text-2xl font-semibold mt-12 mb-4">Recent Delhi project</h2>
    <p class="text-ink text-lg mb-4">
      A cardiology &amp; pulmonology super-speciality clinic in Madhu Vihar,
      East Delhi —
      <a
        href="https://heermedcentre.in"
        target="_blank"
        class="text-accent underline hover:opacity-80"
      >
        visit heermedcentre.in →</a
      >
    </p>

    <h2 class="text-2xl font-semibold mt-12 mb-4">
      Frequently Asked Questions
    </h2>
    <div class="space-y-6 mb-8">
      {
        faqs.map((faq) => (
          <div class="border-b border-border pb-6">
            <h3 class="font-semibold text-lg mb-2">{faq.question}</h3>
            <p class="text-muted">{faq.answer}</p>
          </div>
        ))
      }
    </div>

    <div
      class="mt-16 border border-dashed border-border rounded-xl p-10 text-center"
    >
      <h3 class="text-xl font-semibold mb-3">
        Building a website for your Delhi practice or business?
      </h3>
      <a
        href="/#contact"
        class="inline-block px-8 py-3 bg-accent text-accent-ink font-medium rounded-full hover:opacity-90 transition"
      >
        Start a Project</a
      >
    </div>
  </section>
</BaseLayout>
