---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollTopButton from "../components/ScrollTopButton.astro";
import WhatsAppBubble from "../components/WhatsAppBubble.astro";
import { SITE_CONFIG, SCHEMA_ORG } from "../config";

const {
  title = SITE_CONFIG.title,
  description = SITE_CONFIG.description,
  schema: schemaProp,
  ogImage,
  noindex = false,
} = Astro.props;

// Site origin (e.g. https://groverhq.com/) — same on every page.
const siteOrigin = Astro.site ?? new URL(SITE_CONFIG.url);

// Per-page canonical URL — THIS must vary per page, unlike siteOrigin.
// Previously this was hardcoded to siteOrigin on every page, which told
// Google every new page's canonical was the homepage.
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();

const resolvedOgImage = ogImage
  ? new URL(ogImage, siteOrigin).toString()
  : new URL(SITE_CONFIG.ogImage, siteOrigin).toString();

// Organization schema stays anchored to the homepage (correct for an
// Organization/LocalBusiness entity). Individual pages can pass a `schema`
// prop — a single object, or an array (e.g. [Service, BreadcrumbList, FAQPage])
// — to override or extend this default. Each entry renders as its own
// JSON-LD <script> tag.
const defaultSchema = { ...SCHEMA_ORG, url: siteOrigin.href };
const schemaList = schemaProp
  ? Array.isArray(schemaProp)
    ? schemaProp
    : [schemaProp]
  : [defaultSchema];
---

<html lang="en" data-theme="noir">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta
      name="description"
      content={description ||
        "GroverHQ builds fast, scalable websites, apps, and automations for modern businesses."}
    />

    <!-- Keywords (light, non-spammy) -->
    <meta
      name="keywords"
      content="digital solutions, web development, app development, bots, automation, AI, CRM systems, internal tools, ecommerce, integrations, Mohali tech agency, GroverHQ"
    />

    <meta name="author" content="GroverHQ" />
    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large"}
    />
    <meta name="theme-color" content="#0B0D10" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Performance hints -->
    <link rel="preconnect" href="https://static.cloudflareinsights.com" />
    <link rel="preconnect" href="https://formspree.io" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Apple Touch Icon -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={description ||
        "Fast, scalable digital products for modern businesses."}
    />
    <meta property="og:image" content={resolvedOgImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Grover_HQ" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content={description ||
        "Fast, scalable digital products for modern businesses."}
    />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- JSON-LD Schema -->
    {
      schemaList.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }

    <!-- Cloudflare Web Analytics -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "817646fdca6249d191a9d4b9ea7e0a89"}'></script>
  </head>

  <body class="bg-bg text-ink">
    <Navbar />
    <main class="min-h-screen">
      <slot />
    </main>
    <Footer />
    <ScrollTopButton />
    <WhatsAppBubble />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add("visible");
          });
        },
        { threshold: 0.15 },
      );

      document
        .querySelectorAll(".fade-up")
        .forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
